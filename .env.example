# OpenAI-compatible API (OpenAI, DeepSeek, OpenRouter, Ollama, etc.)
#
# OpenAI (censored by provider):
#   FIVETICK_API_BASE=https://api.openai.com/v1
#   FIVETICK_API_KEY=sk-...
#   FIVETICK_MODEL=gpt-4o-mini
#
# Uncensored local (Ollama) — recommended for 5Tick “uncensored” goal:
FIVETICK_API_BASE=http://127.0.0.1:11434/v1
FIVETICK_API_KEY=ollama
FIVETICK_MODEL=dolphin-llama3:8b
# Heavy alt (needs ~20GB+ free RAM): dolphin-mixtral:8x7b
#
# OpenRouter example:
#   FIVETICK_API_BASE=https://openrouter.ai/api/v1
#   FIVETICK_API_KEY=sk-or-...
#   FIVETICK_MODEL=meta-llama/llama-3.1-70b-instruct

# Agent server
FIVETICK_HOST=127.0.0.1
FIVETICK_PORT=3847

# Workspace root the agent may read/write (defaults to process cwd if empty)
FIVETICK_WORKSPACE=

# 1 = IDE must Accept writes/terminal (recommended). 0 = auto-apply (not content censorship).
FIVETICK_SAFE_MODE=1

# Cloud (https://ai.11tick.com → local :3850)
FIVETICK_CLOUD_HOST=0.0.0.0
FIVETICK_CLOUD_PORT=3850
FIVETICK_PUBLIC_BASE_URL=https://ai.11tick.com
FIVETICK_AGENT_URL=http://127.0.0.1:3847
FIVETICK_ADMIN_TOKEN=5tick-admin-dev

# Keep AUTH off until GitHub/Google client IDs are set, then FIVETICK_AUTH_ENABLED=1
FIVETICK_AUTH_ENABLED=0
FIVETICK_GITHUB_CLIENT_ID=
FIVETICK_GITHUB_CLIENT_SECRET=
FIVETICK_GOOGLE_CLIENT_ID=
FIVETICK_GOOGLE_CLIENT_SECRET=

FIVETICK_BILLING_ENABLED=1
FIVETICK_FREE_DAILY_RUNS=50
FIVETICK_STRIPE_SECRET_KEY=
FIVETICK_STRIPE_WEBHOOK_SECRET=

# Provider switcher on https://ai.11tick.com
FIVETICK_DEFAULT_PROVIDER=ollama
FIVETICK_OPENAI_API_KEY=
FIVETICK_OPENAI_MODEL=gpt-4o-mini
FIVETICK_OPENROUTER_API_KEY=
FIVETICK_OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional MT5 Manager / Meta price API (live bid/ask + daily OHLC → pivots)
FIVETICK_MT5_API_BASE=
FIVETICK_MT5_API_KEY=
FIVETICK_MT5_SYMBOL=XAUUSD
FIVETICK_MT5_PRICE_PATH=/price
FIVETICK_MT5_OHLC_PATH=/ohlc
